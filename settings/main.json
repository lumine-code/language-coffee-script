{
  ".source.coffee": {
    "editor": {
      "commentStart": "# ",
      "commentDelimiters": {
        "line": "#"
      },
      "autoIndentOnPaste": false
    }
  },
  ".source.litcoffee, .source.coffee.md": {
    "editor": {
      "commentStart": "<!-- ",
      "commentEnd": " -->",
      "commentDelimiters": {
        "block": ["<!--", "-->"]
      }
    }
  }
}
